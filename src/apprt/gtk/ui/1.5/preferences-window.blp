using Gtk 4.0;
using Adw 1;

template $GhosttyPtyxisPreferencesWindow: Adw.PreferencesWindow {
  default-height: 700;
  height-request: 294;
  width-request: 360;
  title: _("Preferences");

  ShortcutController {
    Shortcut {
      trigger: "<control>w";
      action: "action(window.close)";
    }
  }

  Adw.PreferencesPage appearance_page {
    title: _("Appearance");
    icon-name: "font-select-symbolic";

    Adw.PreferencesGroup {
      title: _("Palette");

      [header-suffix]
      Button {
        styles [
          "flat",
        ]

        Adw.ButtonContent {
          icon-name: "pan-down-symbolic";
          label: _("Show All Palettes");
        }
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        min-content-height: 320;
        max-content-height: 480;
        propagate-natural-height: true;

        FlowBox palette_flowbox {
          column-spacing: 9;
          row-spacing: 9;
          min-children-per-line: 2;
          max-children-per-line: 2;
          selection-mode: none;
          homogeneous: true;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Window");

      Adw.ActionRow {
        title: _("Transparency");
        subtitle: _("Reduces the opacity of the background window");
        activatable-widget: opacity_scale;

        Scale opacity_scale {
          orientation: horizontal;
          width-request: 200;
          valign: center;
          draw-value: true;
          value-pos: right;
          digits: 2;

          marks [
            mark (0.25),
            mark (0.5),
            mark (0.75),
          ]

          adjustment: Adjustment {
            lower: 0.0;
            upper: 1.0;
            step-increment: 0.05;
            page-increment: 0.25;
            value: 1.0;
          };
        }
      }

      Adw.SwitchRow background_blur_row {
        title: _("Background Blur");
        subtitle: _("Blur content visible through a transparent background");
      }
    }

    Adw.PreferencesGroup {
      title: _("Font");

      Adw.ExpanderRow use_system_font_row {
        title: _("Use System _Font");
        use-underline: true;
        show-enable-switch: false;

        [action]
        Switch use_system_font_switch {
          halign: end;
          valign: center;
        }

        Adw.ActionRow custom_font_row {
          title: _("Custom Font");
          activatable-widget: font_button;

          [suffix]
          FontDialogButton font_button {
            valign: center;

            dialog: FontDialog {
              title: _("Choose a Terminal Font");
              modal: true;
            };
          }
        }
      }

    }

    Adw.PreferencesGroup {
      Adw.SpinRow line_spacing_row {
        title: _("Line Spacing");
        digits: 2;

        adjustment: Adjustment {
          lower: 1.0;
          upper: 2.0;
          value: 1.0;
          step-increment: 0.1;
          page-increment: 0.5;
        };
      }

      Adw.SpinRow column_spacing_row {
        title: _("Column Spacing");
        digits: 2;

        adjustment: Adjustment {
          lower: 1.0;
          upper: 2.0;
          value: 1.0;
          step-increment: 0.1;
          page-increment: 0.5;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Cursor");

      Adw.ComboRow cursor_shape_row {
        title: _("Cursor Shape");

        model: StringList {
          strings [
            _("Block"),
            _("Hollow Block"),
            _("I-Beam"),
            _("Underline"),
          ]
        };
      }

      Adw.ComboRow cursor_blinking_row {
        title: _("Cursor Blinking");

        model: StringList {
          strings [
            _("Follow System"),
            _("On"),
            _("Off"),
          ]
        };
      }

    }
  }

  Adw.PreferencesPage behavior_page {
    title: _("Behavior");
    icon-name: "preferences-desktop-accessibility-symbolic";

    Adw.PreferencesGroup {
      title: _("Interface");

      Adw.ComboRow tab_position_row {
        title: _("New Tab Position");

        model: StringList {
          strings [
            _("Next"),
            _("Last"),
          ]
        };
      }

      Adw.ComboRow tab_bar_row {
        title: _("Tab Bar");

        model: StringList {
          strings [
            _("Auto"),
            _("Always"),
            _("Never"),
          ]
        };
      }

      Adw.ComboRow tabs_location_row {
        title: _("Tab Bar Position");

        model: StringList {
          strings [
            _("Top"),
            _("Bottom"),
          ]
        };
      }

      Adw.SwitchRow wide_tabs_row {
        title: _("Wide Tabs");
        subtitle: _("Expand tabs to fill the full width of the tab bar");
      }

      Adw.ComboRow window_save_state_row {
        title: _("Restore Window");

        model: StringList {
          strings [
            _("Default"),
            _("Never"),
            _("Always"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Bell");

      Adw.SwitchRow audible_bell_row {
        title: _("Audible Bell");
        subtitle: _("Emit an audible bell when requested by the active tab");
      }

      Adw.SwitchRow attention_bell_row {
        title: _("Attention Bell");
        subtitle: _("Request user attention from the window manager on bell");
      }
    }

    Adw.PreferencesGroup {
      title: _("Display");

      Adw.SwitchRow bold_is_bright_row {
        title: _("Bold is Bright");
        subtitle: _("Render bold text using bright ANSI colors");
      }
    }

    Adw.PreferencesGroup {
      title: _("Mouse and Selection");

      Adw.SwitchRow mouse_hide_while_typing_row {
        title: _("Hide Pointer While Typing");
        subtitle: _("Automatically hide the mouse pointer when typing");
      }

      Adw.ComboRow copy_on_select_row {
        title: _("Copy on Select");

        model: StringList {
          strings [
            _("Off"),
            _("Selection Clipboard"),
            _("System Clipboard"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Scrolling");

      Adw.ComboRow scrollbar_row {
        title: _("Scrollbar");

        model: StringList {
          strings [
            _("System Default"),
            _("Never"),
          ]
        };
      }

      Adw.SwitchRow scroll_on_keystroke_row {
        title: _("Scroll on Keystroke");
        subtitle: _("Scroll to the bottom upon input keystroke");
      }

      Adw.SwitchRow scroll_on_output_row {
        title: _("Scroll on Output");
        subtitle: _("Scroll to the bottom when new content is available");
      }

      Adw.SwitchRow limit_scrollback_row {
        title: _("Limit Scrollback");
        subtitle: _("Restrict the number of lines saved for scrollback");
      }

      Adw.SpinRow scrollback_limit_row {
        title: _("Scrollback Lines");
        subtitle: _("The number of lines to keep for scrollback");
        sensitive: bind limit_scrollback_row.active;

        adjustment: Adjustment {
          lower: 0;
          upper: 1000000;
          value: 10000;
          step-increment: 100;
          page-increment: 1000;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Shell");

      Adw.ComboRow shell_integration_row {
        title: _("Shell Integration");
        subtitle: _("Enables shell integration features like working directory tracking");

        model: StringList {
          strings [
            _("Auto-detect"),
            _("None"),
            _("Bash"),
            _("Elvish"),
            _("Fish"),
            _("Nushell"),
            _("Zsh"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");

      Adw.ComboRow notify_on_finish_row {
        title: _("Notify on Command Finish");
        subtitle: _("Send a notification when a long-running command completes");

        model: StringList {
          strings [
            _("Never"),
            _("When Unfocused"),
            _("Always"),
          ]
        };
      }

      Adw.SwitchRow desktop_notifications_row {
        title: _("Desktop Notifications");
        subtitle: _("Allow the terminal to send desktop notifications via OSC 9 or 777");
      }
    }

    Adw.PreferencesGroup {
      title: _("Safety");

      Adw.ComboRow confirm_close_row {
        title: _("Confirm Before Closing");

        model: StringList {
          strings [
            _("Never"),
            _("When Running"),
            _("Always"),
          ]
        };
      }
    }
  }

  Adw.PreferencesPage shortcuts_page {
    title: _("Shortcuts");
    icon-name: "preferences-desktop-keyboard-shortcuts-symbolic";

    Adw.PreferencesGroup {
      title: _("Config");
      description: _("Keybindings are set via `keybind = trigger=action` lines in your config file. Active bindings are listed below.");

      Adw.ButtonRow open_config_row {
        title: _("Open Config File");
        start-icon-name: "document-edit-symbolic";
        action-name: "app.open-config";
      }

      Adw.ButtonRow reload_config_row {
        title: _("Reload Config");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.reload-config";
      }
    }

    Adw.PreferencesGroup {
      title: _("Active Keybindings");

      ListBox shortcuts_listbox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }
  }

  Adw.PreferencesPage profiles_page {
    title: _("Profiles");
    icon-name: "system-users-symbolic";

    Adw.PreferencesGroup profiles_group {
      title: _("Profiles");
      description: _("A profile is a snapshot of your current Ghostty configuration. Switching applies that snapshot live; \"Save\" overwrites a profile with the current settings.");

      [header-suffix]
      Button add_profile_button {
        styles [
          "flat",
        ]

        Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("Add");
        }
      }

      ListBox profiles_listbox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }
  }
}
