using Gtk 4.0;
using Adw 1;

template $GhosttyPtyxisPreferencesWindow: Adw.PreferencesWindow {
  default-height: 700;
  height-request: 294;
  width-request: 360;
  title: _("Preferences");

  ShortcutController {
    Shortcut {
      trigger: "<control>w";
      action: "action(window.close)";
    }
  }

  Adw.PreferencesPage appearance_page {
    title: _("Appearance");
    icon-name: "font-select-symbolic";

    Adw.PreferencesGroup {
      title: _("Palette");

      [header-suffix]
      Button {
        styles [
          "flat",
        ]

        Adw.ButtonContent {
          icon-name: "down-small-symbolic";
          label: _("Show All Palettes");
        }
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        min-content-height: 320;
        max-content-height: 480;
        propagate-natural-height: true;

        FlowBox palette_flowbox {
          column-spacing: 9;
          row-spacing: 9;
          min-children-per-line: 2;
          max-children-per-line: 2;
          selection-mode: none;
          homogeneous: true;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Window");

      Adw.ActionRow {
        title: _("Transparency");
        subtitle: _("Reduces the opacity of the background window");
        activatable-widget: opacity_scale;

        Scale opacity_scale {
          orientation: horizontal;
          width-request: 200;
          valign: center;
          draw-value: true;
          value-pos: right;
          digits: 2;

          marks [
            mark (0.25),
            mark (0.5),
            mark (0.75),
          ]

          adjustment: Adjustment {
            lower: 0.0;
            upper: 1.0;
            step-increment: 0.05;
            page-increment: 0.25;
            value: 1.0;
          };
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Font");

      Adw.ExpanderRow use_system_font_row {
        title: _("Use System _Font");
        use-underline: true;
        show-enable-switch: false;

        [action]
        Switch use_system_font_switch {
          halign: end;
          valign: center;
        }

        Adw.ActionRow custom_font_row {
          title: _("Custom Font");
          activatable-widget: font_button;

          [suffix]
          FontDialogButton font_button {
            valign: center;

            dialog: FontDialog {
              title: _("Choose a Terminal Font");
              modal: true;
            };
          }
        }
      }
    }

    Adw.PreferencesGroup {
      Adw.SpinRow line_spacing_row {
        title: _("Line Spacing");
        digits: 2;

        adjustment: Adjustment {
          lower: 1.0;
          upper: 2.0;
          value: 1.0;
          step-increment: 0.1;
          page-increment: 0.5;
        };
      }

      Adw.SpinRow column_spacing_row {
        title: _("Column Spacing");
        digits: 2;

        adjustment: Adjustment {
          lower: 1.0;
          upper: 2.0;
          value: 1.0;
          step-increment: 0.1;
          page-increment: 0.5;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Cursor");

      Adw.ComboRow cursor_shape_row {
        title: _("Cursor Shape");

        model: StringList {
          strings [
            _("Block"),
            _("I-Beam"),
            _("Underline"),
          ]
        };
      }

      Adw.ComboRow cursor_blinking_row {
        title: _("Cursor Blinking");

        model: StringList {
          strings [
            _("Follow System"),
            _("On"),
            _("Off"),
          ]
        };
      }
    }
  }

  Adw.PreferencesPage behavior_page {
    title: _("Behavior");
    icon-name: "preferences-desktop-accessibility-symbolic";

    Adw.PreferencesGroup {
      title: _("Interface");

      Adw.ComboRow tab_position_row {
        title: _("New Tab Position");

        model: StringList {
          strings [
            _("Next"),
            _("Last"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Bell");

      Adw.SwitchRow audible_bell_row {
        title: _("Audible Bell");
        subtitle: _("Emit an audible bell when requested by the active tab");
      }

      Adw.SwitchRow attention_bell_row {
        title: _("Attention Bell");
        subtitle: _("Request user attention from the window manager on bell");
      }
    }

    Adw.PreferencesGroup {
      title: _("Display");

      Adw.SwitchRow bold_is_bright_row {
        title: _("Bold is Bright");
        subtitle: _("Render bold text using bright ANSI colors");
      }
    }

    Adw.PreferencesGroup {
      title: _("Scrolling");

      Adw.SwitchRow limit_scrollback_row {
        title: _("Limit Scrollback");
        subtitle: _("Restrict the number of lines saved for scrollback");
      }

      Adw.SpinRow scrollback_limit_row {
        title: _("Scrollback Lines");
        subtitle: _("The number of lines to keep for scrollback");
        sensitive: bind limit_scrollback_row.active;

        adjustment: Adjustment {
          lower: 0;
          upper: 1000000;
          value: 10000;
          step-increment: 100;
          page-increment: 1000;
        };
      }
    }
  }

  Adw.PreferencesPage shortcuts_page {
    title: _("Shortcuts");
    icon-name: "preferences-desktop-keyboard-shortcuts-symbolic";

    Adw.PreferencesGroup {
      title: _("Keybindings");
      description: _("Keybindings are configured in your Ghostty config file. Use `keybind = …` lines — for example, `keybind = ctrl+shift+t=new_tab`. See the Ghostty documentation for the full action vocabulary.");

      Adw.ButtonRow open_config_row {
        title: _("Open Config File");
        start-icon-name: "document-edit-symbolic";
        action-name: "app.open-config";
      }

      Adw.ButtonRow reload_config_row {
        title: _("Reload Config");
        start-icon-name: "view-refresh-symbolic";
        action-name: "app.reload-config";
      }
    }
  }

  Adw.PreferencesPage profiles_page {
    title: _("Profiles");
    icon-name: "system-users-symbolic";

    Adw.PreferencesGroup {
      title: _("Profiles");
      description: _("Ghostty does not have a built-in profile system. The configuration shown on the other pages is your single, default profile. To switch behavior between launches, maintain alternate config files and start Ghostty with `--config-file=…`.");

      ListBox profiles_listbox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.ActionRow default_profile_row {
          title: _("Default");
          subtitle: _("~/.config/ghostty/config");
          activatable: false;

          [suffix]
          Image {
            icon-name: "object-select-symbolic";
          }
        }
      }
    }
  }
}
