using Gtk 4.0;
using Adw 1;

template $GhosttyPtyxisPreferencesWindow: Adw.PreferencesWindow {
  default-height: 700;
  height-request: 294;
  width-request: 360;
  title: _("Preferences");

  ShortcutController {
    Shortcut {
      trigger: "<control>w";
      action: "action(window.close)";
    }
  }

  Adw.PreferencesPage appearance_page {
    title: _("Appearance");
    icon-name: "applications-graphics-symbolic";

    Adw.PreferencesGroup {
      title: _("Palette");

      [header-suffix]
      Button {
        styles [
          "flat",
        ]

        Adw.ButtonContent {
          icon-name: "down-small-symbolic";
          label: _("Show All Palettes");
        }
      }

      ScrolledWindow {
        hscrollbar-policy: never;
        min-content-height: 320;
        max-content-height: 480;
        propagate-natural-height: true;

        FlowBox palette_flowbox {
          column-spacing: 9;
          row-spacing: 9;
          max-children-per-line: 3;
          selection-mode: none;
          homogeneous: true;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Window");

      Adw.ActionRow {
        title: _("Transparency");
        subtitle: _("Reduces the opacity of the background window");
        activatable-widget: opacity_scale;

        Scale opacity_scale {
          orientation: horizontal;
          width-request: 200;
          valign: center;
          draw-value: true;
          value-pos: right;

          adjustment: Adjustment {
            lower: 0.0;
            upper: 1.0;
            step-increment: 0.05;
            page-increment: 0.1;
            value: 1.0;
          };
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Font");

      Adw.SwitchRow use_system_font_row {
        title: _("Use System Font");
      }

      Adw.ActionRow custom_font_row {
        title: _("Custom Font");
        activatable-widget: font_button;

        [suffix]
        FontDialogButton font_button {
          valign: center;

          dialog: FontDialog {
            title: _("Choose a Terminal Font");
            modal: true;
          };
        }
      }

      Adw.SpinRow line_spacing_row {
        title: _("Line Spacing");

        adjustment: Adjustment {
          lower: 0.5;
          upper: 4.0;
          value: 1.0;
          step-increment: 0.05;
          page-increment: 0.1;
        };
      }

      Adw.SpinRow column_spacing_row {
        title: _("Column Spacing");

        adjustment: Adjustment {
          lower: 0.5;
          upper: 4.0;
          value: 1.0;
          step-increment: 0.05;
          page-increment: 0.1;
        };
      }

      Adw.ComboRow blinking_text_row {
        title: _("Blinking Text");

        model: StringList {
          strings [
            _("Always"),
            _("Never"),
            _("Focused"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Cursor");

      Adw.ComboRow cursor_shape_row {
        title: _("Cursor Shape");

        model: StringList {
          strings [
            _("Block"),
            _("I-Beam"),
            _("Underline"),
          ]
        };
      }

      Adw.ComboRow cursor_blinking_row {
        title: _("Cursor Blinking");

        model: StringList {
          strings [
            _("Follow System"),
            _("On"),
            _("Off"),
          ]
        };
      }
    }
  }

  Adw.PreferencesPage behavior_page {
    title: _("Behavior");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Terminal");

      Adw.SwitchRow audible_bell_row {
        title: _("Audible Bell");
        subtitle: _("Play a sound on terminal bell");
      }

      Adw.SwitchRow bold_is_bright_row {
        title: _("Bold is Bright");
        subtitle: _("Render bold text using bright ANSI colors");
      }
    }

    Adw.PreferencesGroup {
      title: _("Scrollback");

      Adw.SpinRow scrollback_limit_row {
        title: _("Scrollback Limit");
        subtitle: _("Number of lines retained for scrollback (0 = unlimited)");

        adjustment: Adjustment {
          lower: 0;
          upper: 1000000;
          value: 10000;
          step-increment: 100;
          page-increment: 1000;
        };
      }
    }
  }

  Adw.PreferencesPage shortcuts_page {
    title: _("Shortcuts");
    icon-name: "input-keyboard-symbolic";

    Adw.PreferencesGroup {
      description: _("Keybindings are configured in your Ghostty config file. A full shortcut editor lands in the next step.");
    }
  }

  Adw.PreferencesPage profiles_page {
    title: _("Profiles");
    icon-name: "system-users-symbolic";

    Adw.PreferencesGroup {
      title: _("Profiles");

      ListBox profiles_listbox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.ActionRow default_profile_row {
          title: _("Default");
          activatable: true;

          [suffix]
          Image {
            icon-name: "object-select-symbolic";
          }

          [suffix]
          MenuButton {
            valign: center;
            icon-name: "view-more-symbolic";

            styles [
              "flat",
            ]
          }
        }

        Adw.ButtonRow add_profile_row {
          title: _("Add Profile");
          start-icon-name: "list-add-symbolic";
        }
      }
    }
  }
}
