[Desktop Entry]
Version=1.0
Name=GhosttyPtyxis
GenericName=Terminal
Comment=Container-native terminal powered by Ghostty
Type=Application
TryExec=ghostty
Exec=ghostty --gtk-single-instance=false
Icon=dev.hanthor.GhosttyPtyxis
Categories=System;TerminalEmulator;
Keywords=terminal;tty;pty;container;toolbox;distrobox;podman;
StartupNotify=true
StartupWMClass=dev.hanthor.GhosttyPtyxis
Terminal=false
Actions=new-window;
X-GNOME-UsesNotifications=true
X-TerminalArgExec=-e
X-TerminalArgTitle=--title=
X-TerminalArgAppId=--class=
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--wait-after-command
DBusActivatable=false

[Desktop Action new-window]
Name=New Window
Exec=ghostty --gtk-single-instance=false
